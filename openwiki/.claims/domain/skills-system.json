    {
      "id": "claim_84bd3a83d6014454ae3e0a48ff26b5c0",
      "statement": "Skill storage uses two Strap-named Postgres tables, strap_skills (one row per strap_id+name, current revision) and strap_skill_versions (full document snapshots per skill_id+revision); both have RLS enabled with all grants revoked from public/anon/authenticated and only service_role gets select/insert/update/delete, so no client role receives table access.",
      "evidence": [
        {
          "resource": "repo://supabase/migrations/20260913133911_shared_skills.sql#L4-L30",
          "version": "repo-lines-v1:sha256:1ba385ed27cd9f9ce2277ceb837ac73687d818af33c7a0751a688d38863f3a43:"
        },
        {
          "resource": "repo://supabase/migrations/20260913153559_bound_skill_storage.sql#L1-L8",
          "version": "repo-lines-v1:sha256:f633f27319f9d422d22623c2a6ab2a169f3c030ae1024381056c7f47031ace24:"
        }
      ]
    },
    {
      "id": "claim_8156e1731d0d446ebad6f0543515e4ce",
      "statement": "strap_skills_read takes FOR SHARE locks on the profile and the caller's creed_members row, allows any member to read, returns metadata (plus storageBytes and canManage) when p_name is null and the skill document plus version summaries when p_name is set, and rechecks live membership every call.",
      "evidence": [
        {
          "resource": "repo://supabase/migrations/20260913153559_bound_skill_storage.sql#L10-L48",
          "version": "repo-lines-v1:sha256:5cf4485766c17f0bc5cc9414f559220b835cfd2eb17e548111f5db7e0bfb1d26:"
        }
      ]
    },
    {
      "id": "claim_4e09e2fea1b641c48e9f9bf2842b75e1",
      "statement": "strap_skill_publish serializes publication with a FOR UPDATE lock on the profile row, requires owner/admin role, rejects a stale baseRevision with PT409 (except an identical-content idempotent retry that returns the current document), caps new libraries at 100 skills with 54000, increments the revision and inserts a version snapshot, deletes versions older than revision-20, and enforces a 64 MiB library budget by pruning oldest history first (never a current revision) and rolling back with 54000 if still over.",
      "evidence": [
        {
          "resource": "repo://supabase/migrations/20260913133911_shared_skills.sql#L78-L133",
          "version": "repo-lines-v1:sha256:93686e7fa1609fb9a50bc18c8d180c563a0cfda1741f21366a3e6e9639433304:"
