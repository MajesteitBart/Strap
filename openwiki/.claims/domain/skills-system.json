        }
      ]
    },
    {
      "id": "claim_3b7c7f812b69475eaf83bae76b3cf34b",
      "statement": "The application layer in lib/skills.ts maps SQL error codes to HTTP statuses (42501 to 403, P0002 to 404, PT409 to 409, 22023 to 400, 54000 to 422, otherwise 503) and validates user/strapId/name/revision before invoking service-role RPCs, so application authorization precedes the RLS-bypassing service_role call.",
      "evidence": [
