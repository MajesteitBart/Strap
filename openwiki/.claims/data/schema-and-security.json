    {
      "id": "claim_92ff02a0d03d4aca9405190b2cb8c56c",
      "statement": "Authorization has no RLS; rowScope(context, table, operation) returns a SQL predicate equivalent to the baseline's 45 RLS policies with three actor kinds: service bypasses the predicate (requires a named purpose), anonymous is always denied, and viewer is scoped by userId; unknown tables or actions deny by default.",
      "evidence": [
        {
          "resource": "repo://lib/authz/policies.ts#L11-L47",
          "version": "repo-lines-v1:sha256:ea89642afa556515499660d3f4e904a5cb9efb53afd098b20c68b0aeed03d45a:"
