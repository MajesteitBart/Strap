        }
      ]
    },
    {
      "id": "claim_ea757fec27d6475e97e36ce961fcd616",
      "statement": "rowScope composes per-table rules: own-manage tables require user_id ownership, personalContent tables require personal-owner writes and membership/hidden-section visibility on reads, memberRead tables require membership for reads, company billing/AI settings and audit/entitlements are owner-or-own scoped, and any non-explicitly-allowed write returns sql false to deny.",
      "evidence": [
        {
          "resource": "repo://lib/authz/policies.ts#L6-L46",
