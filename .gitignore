# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.playwright-cli/
/output/playwright/

# next.js
/.next/
/.next-runtime*/
/.next-preview*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# private workspace artifacts (Codex / Claude / Cursor / etc.)
# Track only Delano's safe repository hooks and compatibility wrapper.
.codex/*
!.codex/hooks.json
.claude/*
!.claude/common/
.claude/common/*
!.claude/common/log-safety.js
.cursor/
.aider*

# local Delano runtime evidence and viewer state
/.agents/logs/*.jsonl
/.project/viewer/

# launch video workspace (Remotion) - local only, never pushed
/video/

# private project notes — not shipped publicly
/project-context/
/strap.md
/creed.md
/design.md
/docs.md

# legacy / accidental git working trees
.git.backup-*

# Supabase CLI temp state (contains the linked project ref + org)
supabase/.temp/

# OS / editor cruft
*.log
.idea/
.vscode/

# Local Netlify folder
.netlify
