{
  "name": "@bvdm/strap",
  "version": "0.1.0",
  "description": "Bootstrap agents with context, skills, and secrets from the terminal.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "strap": "dist/src/bin.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm test",
    "test": "npm run build && node --test \"dist/tests/*.test.js\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "open": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "strap",
    "mcp",
    "cli",
    "context",
    "ai"
  ],
  "homepage": "https://strap.bvdm.ai"
}
