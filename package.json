{
  "name": "strap",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --max-http-header-size=65536 node_modules/vite/bin/vite.js dev",
    "build": "vite build",
    "start": "node --max-http-header-size=65536 --env-file-if-exists=.env.local scripts/serve.mjs",
    "lint": "eslint",
    "test": "node --test --experimental-strip-types tests/*.test.ts tests/db/*.test.ts",
    "audit:brand": "node --experimental-strip-types scripts/check-strap-rebrand.mts",
    "indexnow": "node --experimental-strip-types scripts/indexnow-ping.ts",
    "db:up": "docker compose up -d --wait",
    "db:ping": "node --experimental-strip-types scripts/db-ping.mts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --experimental-strip-types scripts/db-migrate.mts",
    "test:db": "node --import ./scripts/db-env.mts --test --experimental-strip-types tests/db/*.test.ts",
    "verify:local": "node scripts/verify-local-runtime.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "@tiptap/extension-bubble-menu": "^3.22.0",
    "@tiptap/extension-code-block-lowlight": "^3.22.5",
    "@tiptap/extension-highlight": "^3.22.0",
    "@tiptap/extension-link": "^3.22.0",
    "@tiptap/extension-placeholder": "^3.22.0",
    "@tiptap/extension-task-item": "^3.22.0",
    "@tiptap/extension-task-list": "^3.22.0",
    "@tiptap/extension-text-align": "^3.22.0",
    "@tiptap/react": "^3.22.0",
    "@tiptap/starter-kit": "^3.22.0",
    "@tiptap/suggestion": "^3.22.0",
    "@vercel/og": "^0.11.1",
    "bcryptjs": "3.0.3",
    "better-auth": "1.7.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "drizzle-orm": "0.45.2",
    "framer-motion": "^12.38.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.7.0",
    "motion": "^12.38.0",
    "postgres": "3.4.9",
    "qrcode.react": "4.2.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/diff": "^7.0.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "0.31.10",
    "eslint": "^9",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.4.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.3.2"
  },
  "description": "Bootstrap your agents with context, skills, and keys.",
  "main": "index.js",
  "directories": {
    "lib": "lib",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MajesteitBart/Strap.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/MajesteitBart/Strap/issues"
  },
  "homepage": "https://strap.bvdm.ai",
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  }
}
